#!/usr/bin/env nu

# Simple TODO app in Nushell using Markdown format
# Usage:
#   todo.nu add "<task description>"
#   todo.nu remove <task number>
#   todo.nu list
#   todo.nu clear

let nudo_dir = ($env.HOME | path join ".config" "nudo")
let projects_dir = ($nudo_dir | path join "projects")
let state_file = ($nudo_dir | path join "state.json")

# Initialize the nudo directory structure if it doesn't exist
if (not ($nudo_dir | path exists)) {
    mkdir $nudo_dir
}

if (not ($projects_dir | path exists)) {
    mkdir $projects_dir
}

# Initialize state file with default project
if (not ($state_file | path exists)) {
    {current_project: "default"} | to json | save --raw $state_file
}

# Get current project from state
def get_current_project [] {
    let state = (open $state_file)
    $state.current_project
}

# Set current project in state
def set_current_project [project: string] {
    {current_project: $project} | to json | save --force --raw $state_file
}

# Get the todo file path for the current project
def get_todo_file [] {
    let project = (get_current_project)
    $projects_dir | path join $"($project).md"
}

# Initialize a project file if it doesn't exist
def init_project_file [file_path: string] {
    if (not ($file_path | path exists)) {
        "# TODO\n\n### Tasks\n" | save --raw $file_path
    }
}

# Parse markdown todos into structured data
def load_todos [] {
    let todo_file = (get_todo_file)
    init_project_file $todo_file
    let content = (open $todo_file | lines)

    $content
    | each { |line|
        # Match lines like: - [ ] Task or - [x] Task
        if ($line | str starts-with "- [") {
            let completed = ($line | str contains "[x]")
            let task_text = ($line | str replace --regex '^- \[[x ]\] ' '')
            {
                task: $task_text
                completed: $completed
            }
        } else {
            null
        }
    }
    | where { |item| $item != null }
}

# Save todos to markdown file
def save_todos [todos] {
    let todo_file = (get_todo_file)
    let header = "# TODO\n\n### Tasks\n"
    let task_lines = (
        $todos
        | each { |todo|
            let checkbox = if $todo.completed { "[x]" } else { "[ ]" }
            $"- ($checkbox) ($todo.task)"
        }
        | str join "\n"
    )

    let content = if ($todos | is-empty) {
        $header
    } else {
        $header + $task_lines + "\n"
    }

    $content | save --force --raw $todo_file
}

# Add a new todo
def add_todo [task: string] {
    let todos = load_todos
    let new_todo = {
        task: $task
        completed: false
    }
    let updated = ($todos | append $new_todo)
    save_todos $updated
    print $"✓ Added: ($task)"
}

# Remove a todo by number
def remove_todo [task_num: int] {
    let todos = load_todos
    if ($task_num < 1 or $task_num > ($todos | length)) {
        print $"✗ Invalid task number: ($task_num)"
        return
    }
    let task_text = $todos | get ($task_num - 1) | get task
    let updated = ($todos | enumerate | where { |it| ($it.index + 1) != $task_num } | get item)
    save_todos $updated
    print $"✓ Removed: ($task_text)"
}

# List all todos
def list_todos [] {
    let todos = load_todos
    if ($todos | is-empty) {
        print "No todos yet!"
        return
    }
    $todos | enumerate | each { |it|
        let num = ($it.index + 1)
        let task = $it.item.task
        let check = if $it.item.completed { "✓" } else { "○" }
        print $"($num). [($check)] ($task)"
    } | ignore
}

# Clear all todos
def clear_todos [] {
    save_todos []
    print "✓ All todos cleared"
}

# Create a new project
def create_project [project: string] {
    let project_file = ($projects_dir | path join $"($project).md")
    if ($project_file | path exists) {
        print $"✗ Project '($project)' already exists"
        return
    }
    init_project_file $project_file
    print $"✓ Created project: ($project)"
    print $"  Location: ($project_file)"
}

# Switch to a different project
def switch_project [project: string] {
    let project_file = ($projects_dir | path join $"($project).md")
    if (not ($project_file | path exists)) {
        print $"✗ Project '($project)' does not exist"
        print $"  Use 'nudo create-project ($project)' to create it"
        return
    }
    set_current_project $project
    print $"✓ Switched to project: ($project)"
}

# List all projects
def list_projects [] {
    let current = (get_current_project)
    let projects = (ls $projects_dir | where type in [file symlink] and name =~ '.md$' | get name | each { |path|
        $path | path basename | str replace '.md' ''
    })

    if ($projects | is-empty) {
        print "No projects yet!"
        print "Create one with: nudo create-project <name>"
        return
    }

    print "Projects:"
    $projects | each { |project|
        if $project == $current {
            print $"  * ($project) \(current\)"
        } else {
            print $"    ($project)"
        }
    } | ignore
}

# Show help message
def show_help [] {
    let current_project = (get_current_project)
    let todo_file = (get_todo_file)

    print "nudo - A project-based TODO list manager using Markdown"
    print ""
    print "USAGE:"
    print "  nudo [COMMAND] [OPTIONS]"
    print ""
    print "TASK COMMANDS:"
    print "  (no command)          List all tasks in current project"
    print "  add, a <task>         Add a new task"
    print "  remove, rm <number>   Remove a task by number"
    print "  list, ls, lst         List all tasks"
    print "  clear, clr            Clear all tasks in current project"
    print ""
    print "PROJECT COMMANDS:"
    print "  create-project, cp <name>  Create a new project"
    print "  switch-project, sp <name>  Switch to a different project"
    print "  projects, lsp              List all projects"
    print ""
    print "OTHER COMMANDS:"
    print "  help, h               Show this help message"
    print ""
    print "OPTIONS:"
    print "  -h, --help            Show this help message"
    print ""
    print "EXAMPLES:"
    print "  nudo cp work                  # Create a work project"
    print "  nudo sp work                  # Switch to work project"
    print "  nudo a \"Fix bug in login\"     # Add task to current project"
    print "  nudo lsp                      # List all projects"
    print "  nudo                          # List tasks in current project"
    print "  nudo rm 1                     # Remove first task"
    print ""
    print $"CURRENT PROJECT: ($current_project)"
    print $"FILE LOCATION: ($todo_file)"
    print ""
    print "You can also manually edit the markdown files directly!"
}

# Main command handler
def main [command?: string, ...args] {
    # Handle --help and -h flags
    if ($command == "--help" or $command == "-h") {
        show_help
        return
    }

    if ($command == null) {
        list_todos
        return
    }

    match $command {
        "add" | "a" => {
            if ($args | is-empty) {
                print "Usage: nudo add \"<task description>\""
                return
            }
            add_todo ($args | str join " ")
        }
        "remove" | "rm" => {
            if ($args | is-empty) {
                print "Usage: nudo remove <task number>"
                return
            }
            let task_num = $args | first
            if ($task_num | describe) =~ 'int' {
                remove_todo $task_num
            } else {
                try {
                    remove_todo ($task_num | into int)
                } catch {
                    print "✗ Task number must be a number"
                }
            }
        }
        "list" | "ls" | "lst" => {
            list_todos
        }
        "clear" | "clr" => {
            clear_todos
        }
        "create-project" | "cp" => {
            if ($args | is-empty) {
                print "Usage: nudo create-project <name>"
                return
            }
            create_project ($args | first)
        }
        "switch-project" | "sp" => {
            if ($args | is-empty) {
                print "Usage: nudo switch-project <name>"
                return
            }
            switch_project ($args | first)
        }
        "projects" | "lsp" => {
            list_projects
        }
        "help" | "h" => {
            show_help
        }
        _ => {
            print $"Unknown command: ($command)"
            print ""
            show_help
        }
    }
}